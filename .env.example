# PipelineIQ — Environment Variable Template
#
# Copy this file to .env and fill in real values.
# .env is in .gitignore and must NEVER be committed.
# All secrets are also stored in Azure Key Vault.
# The generator and FastAPI read from Key Vault in production
# and from this .env file in local development.

# ── Azure Subscription ──────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=pipelineiq-rg-dev

# ── Azure SQL Database (Velora source system) ────────────────────────────────
AZURE_SQL_SERVER=pipelineiq-sql-dev.database.windows.net
AZURE_SQL_DATABASE=velora
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=

# ── PostgreSQL Flexible Server (PipelineIQ control plane) ───────────────────
POSTGRES_HOST=pipelineiq-postgres-dev.postgres.database.azure.com
POSTGRES_DB=pipelineiq
POSTGRES_USER=
POSTGRES_PASSWORD=
# Full connection URL (alternative to individual params above)
POSTGRES_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}/${POSTGRES_DB}?sslmode=require

# ── ADLS Gen2 (data lake) ────────────────────────────────────────────────────
ADLS_ACCOUNT_NAME=pipelineiqadlsdev
ADLS_ACCOUNT_KEY=

# ── Azure OpenAI (AI RCA engine) ─────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_ENDPOINT=https://pipelineiq-openai-dev.openai.azure.com/
OPENAI_DEPLOYMENT_NAME=gpt-4o

# ── Slack (alert delivery) ───────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Databricks ───────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://adb-xxxxxxxxxxxx.azuredatabricks.net
DATABRICKS_TOKEN=

# ── Azure DevOps (IaC webhook auth) ──────────────────────────────────────────
AZURE_DEVOPS_WEBHOOK_SECRET=

# ── Generator settings (overrides config.py defaults) ────────────────────────
GENERATOR_SEED=42
GENERATOR_FAILURE_TYPE=
