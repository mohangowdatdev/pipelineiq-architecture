# PipelineIQ — direnv config
#
# When you cd into this directory, direnv:
#   1. Activates .venv (Python 3.11)
#   2. Loads Azure credentials and project env vars from .env
#
# First time setup (once per machine):
#   brew install direnv
#   echo 'eval "$(direnv hook zsh)"' >> ~/.zshrc
#   direnv allow
#
# This file is committed to git. Secrets live in .env (gitignored).

# Activate project venv (created with python3.11 -m venv .venv)
if [[ -f .venv/bin/activate ]]; then
  source .venv/bin/activate
else
  echo "direnv: .venv not found. Run: /opt/homebrew/opt/python@3.11/bin/python3.11 -m venv .venv"
fi

# Load Azure creds and project env (file is gitignored)
dotenv_if_exists .env
